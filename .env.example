# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=file:./payload.db

# Public URL (used for og, canonical, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container id (e.g. GTM-XXXXXXXX). When set, the
# layout injects the GTM snippet. Leave unset locally so dev traffic
# doesn't pollute production analytics. Configure GA4 *inside* GTM —
# do not also load gtag.js or you'll double-fire pageviews.
# NEXT_PUBLIC_GTM_ID=

# Supabase (optional — used later for media storage / database host)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
