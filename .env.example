# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URI=file:./payload.db

# Public URL (used for og, canonical, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Tag Manager container id (e.g. GTM-XXXXXXXX). When set, the
# layout injects the GTM snippet. Leave unset locally so dev traffic
# doesn't pollute production analytics. Configure GA4 *inside* GTM —
# do not also load gtag.js or you'll double-fire pageviews.
# NEXT_PUBLIC_GTM_ID=

# Search engine ownership verification tokens. Each console issues a token
# from its "verify by HTML tag" flow — paste the content="..." value only
# (NOT the full <meta> tag).
# Google Search Console: search.google.com/search-console
# Bing Webmaster:        bing.com/webmasters
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase (optional — used later for media storage / database host)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe — required for the /invoice payment flow + /api/stripe/webhook.
# In dev, use sandbox keys (sk_test_…). In prod, use live keys (sk_live_…).
# STRIPE_SECRET_KEY: Stripe dashboard → Developers → API keys → Secret key
# STRIPE_WEBHOOK_SECRET: `stripe listen` output locally, or the dashboard's
#   webhook signing secret in production.
# STRIPE_PAYMENT_METHOD_TYPES: comma-separated allowlist; must match the
#   methods enabled in your Stripe dashboard. Leave unset to use the code
#   default (card,us_bank_account,klarna,link,cashapp).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PAYMENT_METHOD_TYPES=card,us_bank_account,klarna,affirm,link,cashapp

# Billing-specific email sender. Falls back to EMAIL_FROM if unset.
# EMAIL_FROM_BILLING=invoicing@blackhartconsulting.com

# Slack incoming webhook for operator notifications (payment received,
# payment failed, new client, etc.).
# SLACK_BILLING_WEBHOOK_URL=
