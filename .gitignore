# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem
.turbo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (except example)
.env*
!.env.example

# Per-environment Caddyfile overrides (dev droplet has a bespoke version
# with Basic Auth removed, dev domain, X-Robots-Tag). Pointed at via
# CADDYFILE_PATH in docker-compose.yml. Only the canonical prod Caddyfile
# is tracked in git.
/Caddyfile.dev
/Caddyfile.local
/Caddyfile.pre-devauth-*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Payload
/payload.db
/payload.db-journal
/payload.db.*.bak
/media
/src/payload-types.ts

# Local working notes (not for prod)
/bhc-website-refresh-prompt.md
/prospects/
/performance_analysis/

# IDE
.vscode/
.idea/

# Claude Code agent tooling — ephemeral worktrees created when subagents
# run with isolation: "worktree". Machine-specific, never meant to be
# versioned. Other .claude/* files (settings.local.json, launch.json) are
# either already tracked or already ignored by their own conventions.
.claude/worktrees/
