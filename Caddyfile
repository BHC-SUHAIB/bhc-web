# Caddy reverse-proxy config for Black Hart Consulting.
#
# Three virtual hosts:
#   1. blackhartconsulting.com + www.blackhartconsulting.com  (canonical, HTTPS)
#   2. blackhart.consulting    + www.blackhart.consulting     (redirects to #1)
#   3. :80 catch-all for IP-based access (useful before DNS propagates)
#
# Caddy automatically obtains Let's Encrypt certs for #1 and #2 once DNS is
# pointing at the droplet. Before DNS is live, #3 serves plain HTTP so you
# can verify the stack via http://<droplet-ip>.

# ---- www → apex permanent redirect ----
# Both versions used to share one block, which made Google see them as
# duplicate URLs without a canonical hint and triggered a Search Console
# "Duplicate without user-selected canonical" warning (2026-05-05). Splitting
# the block forces every www request to 308 to the apex equivalent so there
# is exactly one indexable URL per page.
www.blackhartconsulting.com {
	redir https://blackhartconsulting.com{uri} 308
}

# ---- Canonical domain ----
blackhartconsulting.com {
	encode gzip zstd

	# Long-lived cache on Next's hashed static chunks. Filenames include a
	# build hash, so busting on deploy is automatic. This is the single
	# biggest lever for repeat-visit PSI scores.
	@nextStatic path /_next/static/*
	header @nextStatic {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Self-hosted Google fonts land under /_next/static/media/*; same cache.
	@nextMedia path /_next/static/media/*
	header @nextMedia {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Public brand assets (logos, favicons) change rarely.
	@brand path /brand/*
	header @brand {
		Cache-Control "public, max-age=604800"
	}

	# Long-cache Next.js image-optimization responses. The /_next/image URL
	# is fully content-addressed (`?url=<source>&w=<width>&q=<quality>`), so
	# any change to the source produces a new URL. Safe to mark immutable
	# and cache for 30 days in browsers + intermediate caches.
	#
	# The `>` prefix forces REPLACE — without it Caddy ADDs the header,
	# resulting in two Cache-Control headers in the response (Next sends
	# its own `max-age=14400, must-revalidate` upstream). Verified live
	# 2026-05-06 that plain syntax produced duplicates.
	@nextImage path /_next/image*
	header @nextImage {
		>Cache-Control "public, max-age=2592000, immutable"
	}

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	log {
		output stdout
		format json
	}
}

# ---- Redirect domain ----
blackhart.consulting, www.blackhart.consulting {
	redir https://blackhartconsulting.com{uri} permanent
}

# ---- Sorenori email-confirmation landing (static, isolated from the Next app) ----
# Serves the branded "Email confirmed" page from a bind-mounted dir (see the caddy volume in
# docker-compose.yml). Caddy auto-obtains a Let's Encrypt cert once sorenori.blackhartconsulting.com
# points at this droplet. Fully separate from the apex vhost, so it can't affect the main site.
sorenori.blackhartconsulting.com {
	encode gzip zstd
	root * /srv/sorenori
	file_server
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}
}

# ---- Job-hunt cockpit (jobhunt.blackhartconsulting.com) ----
# Password-protected job-search dashboard, fully isolated from the apex Next
# app. Caddy auto-obtains a Let's Encrypt cert for this subdomain once its DNS
# A record points at the droplet (same automatic flow as sorenori above). The
# app is base-path-free (served at the subdomain root) and handles its own auth.
jobhunt.blackhartconsulting.com {
	encode gzip zstd

	# Allow multipart resume/cover uploads from the daily ingest agent (the app
	# caps each file at 8MB; 40MB covers four files plus overhead).
	request_body {
		max_size 40MB
	}

	reverse_proxy jobhunt:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The whole tool is private; keep it out of search indexes.
		X-Robots-Tag "noindex, nofollow"
	}

	log {
		output stdout
		format json
	}
}

# ---- IP-based fallback (plain HTTP, no TLS) ----
:80 {
	encode gzip zstd
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
}
