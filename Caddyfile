# Caddy reverse-proxy config for Black Hart Consulting.
#
# Three virtual hosts:
#   1. blackhartconsulting.com + www.blackhartconsulting.com  (canonical, HTTPS)
#   2. blackhart.consulting    + www.blackhart.consulting     (redirects to #1)
#   3. :80 catch-all for IP-based access (useful before DNS propagates)
#
# Caddy automatically obtains Let's Encrypt certs for #1 and #2 once DNS is
# pointing at the droplet. Before DNS is live, #3 serves plain HTTP so you
# can verify the stack via http://<droplet-ip>.

# ---- Canonical domain ----
blackhartconsulting.com, www.blackhartconsulting.com {
	encode gzip zstd

	# Long-lived cache on Next's hashed static chunks. Filenames include a
	# build hash, so busting on deploy is automatic. This is the single
	# biggest lever for repeat-visit PSI scores.
	@nextStatic path /_next/static/*
	header @nextStatic {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Self-hosted Google fonts land under /_next/static/media/*; same cache.
	@nextMedia path /_next/static/media/*
	header @nextMedia {
		Cache-Control "public, max-age=31536000, immutable"
	}

	# Public brand assets (logos, favicons) change rarely.
	@brand path /brand/*
	header @brand {
		Cache-Control "public, max-age=604800"
	}

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	log {
		output stdout
		format json
	}
}

# ---- Redirect domain ----
blackhart.consulting, www.blackhart.consulting {
	redir https://blackhartconsulting.com{uri} permanent
}

# ---- IP-based fallback (plain HTTP, no TLS) ----
:80 {
	encode gzip zstd
	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
}
