# Job-Hunt Cockpit secrets.
#
# These are NOT read from this file in production. On the droplet they live in
# the shared /opt/bhc-web/.env (compose passes them into the jobhunt service),
# namespaced with a JOBHUNT_ prefix so they never collide with the main site's
# vars. This file documents what to set.
#
# Add these three lines to /opt/bhc-web/.env:
#
#   JOBHUNT_APP_PASSWORD='Sooby$11'
#   JOBHUNT_SESSION_SECRET=<64-hex, openssl rand -hex 32>
#   JOBHUNT_INGEST_TOKEN=<64-hex, openssl rand -hex 32>
#
# IMPORTANT: single-quote the password because it contains a $ — otherwise the
# shell expands $11 and stores the wrong value.

# ---- Local development only (npm run dev:server) ----
APP_PASSWORD='Sooby$11'
SESSION_SECRET=dev-session-secret-change-me
INGEST_TOKEN=dev-ingest-token-change-me
DATA_DIR=./jobhunt-data
PORT=8080
